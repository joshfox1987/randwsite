/**
 * Simplified Security Rules for R & W Property Solutions.
 * Optimized for ease of use and reliability.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Allow anyone to see and upload project photos for maximum reliability
    match /gallery_images/{imageId} {
      allow read: if true;
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // Allow anyone to read and submit reviews
    match /customer_reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Chatbot leads are private but public can create them
    match /leads/{leadId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }

    // Simple visitor counter permissions
    match /site_analytics/visitorCounter {
      allow get: if isAdmin();
      allow write: if true;
    }

    match /roles_admin/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}